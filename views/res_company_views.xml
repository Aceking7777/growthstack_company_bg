<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_bg_form" model="ir.ui.view">
        <field name="name">res.company.form.bg</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="backend_background" string="Backend Background">
                    <group string="Background Settings">
                        <field name="background_color"/>
                        <field name="background_opacity"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
